        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OrphanClient.Launcher;component/UI/Theme/Colors.xaml" />
                <ResourceDictionary Source="/OrphanClient.Launcher;component/UI/Theme/Typography.xaml" />
                <ResourceDictionary Source="/OrphanClient.Launcher;component/UI/Theme/Surfaces.xaml" />
                <ResourceDictionary Source="/OrphanClient.Launcher;component/UI/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
