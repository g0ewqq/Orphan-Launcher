<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="OrphanMarkImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource PrimaryBrush}" Geometry="M0,0 H6 V6 H0 Z" />
                <GeometryDrawing Brush="{StaticResource PrimaryDimBrush}" Geometry="M8,0 H14 V6 H8 Z" />
                <GeometryDrawing Brush="{StaticResource PrimaryDimBrush}" Geometry="M0,8 H6 V14 H0 Z" />
                <GeometryDrawing Brush="{StaticResource PrimaryBrush}" Geometry="M8,8 H14 V14 H8 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PrimaryChipBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryDimBrush}" />
    </Style>

    <Style x:Key="HairlineBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
    </Style>

</ResourceDictionary>
