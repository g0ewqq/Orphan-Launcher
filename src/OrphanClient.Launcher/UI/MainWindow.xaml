<Window x:Class="OrphanClient.Launcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1120"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource TextFontFamily}"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid ClipToBounds="True">

            <Grid IsHitTestVisible="False">
                <Border Background="{StaticResource BackgroundFallbackBrush}" />
                <Image Source="/Assets/Images/background.jpg" Stretch="UniformToFill" />
                <Border Background="{StaticResource ScrimTopBrush}" />
                <Border Background="{StaticResource ScrimBottomBrush}" />
                <Border Background="{StaticResource ScrimLeftBrush}" />
                <Border Background="{StaticResource ScrimRightBrush}" />
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="15" Height="15" Margin="0,0,11,0" VerticalAlignment="Center" Source="{StaticResource OrphanMarkImage}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BrandTextStyle}">
                            <Run Text="ORPHAN" /><Run Text="CLIENT" Foreground="{StaticResource PrimaryBrush}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,8,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="HomeNavItem"
                                     Checked="OnNavigationChecked"
                                     Content="Home"
                                     GroupName="PrimaryNavigation"
                                     Style="{StaticResource NavItemStyle}"
                                     Tag="&#xE80F;" />
                        <RadioButton x:Name="VersionsNavItem"
                                     Margin="6,0,0,0"
                                     Checked="OnNavigationChecked"
                                     Content="Versions"
                                     GroupName="PrimaryNavigation"
                                     Style="{StaticResource NavItemStyle}"
                                     Tag="&#xE8FD;" />
                        <RadioButton x:Name="SettingsNavItem"
                                     Margin="6,0,0,0"
                                     Checked="OnNavigationChecked"
                                     Content="Settings"
                                     GroupName="PrimaryNavigation"
                                     Style="{StaticResource NavItemStyle}"
                                     Tag="&#xE713;" />
                        <RadioButton x:Name="AccountNavItem"
                                     Margin="6,0,0,0"
                                     Checked="OnNavigationChecked"
                                     Content="Account"
                                     GroupName="PrimaryNavigation"
                                     Style="{StaticResource NavItemStyle}"
                                     Tag="&#xE77B;" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                AutomationProperties.Name="Minimize"
                                Click="OnMinimizeClick"
                                Content="&#xE921;"
                                Style="{StaticResource TitleBarButtonStyle}" />
                        <Button x:Name="MaximizeButton"
                                AutomationProperties.Name="Maximize"
                                Click="OnMaximizeClick"
                                Content="&#xE922;"
                                Style="{StaticResource TitleBarButtonStyle}" />
                        <Button x:Name="CloseButton"
                                AutomationProperties.Name="Close"
                                Click="OnCloseClick"
                                Content="&#xE8BB;"
                                Style="{StaticResource CloseTitleBarButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusIndicator" Grid.Column="0" Margin="20,0,0,0" Style="{StaticResource StatusDotStyle}" />
                    <TextBlock x:Name="StatusStripText"
                               Grid.Column="1"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Opacity="0.55"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="OrphanClient V1" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
