<UserControl x:Class="OrphanClient.Launcher.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,22,40,22">
            <StackPanel MaxWidth="1000">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource EyebrowTextStyle}"
                               Text="ORPHANCLIENT V1" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource DisplayTextStyle}"
                               Text="Welcome back" />
                    <TextBlock x:Name="LaunchStatusText"
                               MaxWidth="520"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               Style="{StaticResource StatusTextStyle}"
                               TextAlignment="Center" />
                </StackPanel>

                <Grid Height="136" Margin="0,22,0,0" HorizontalAlignment="Center">
                    <Ellipse Width="440" Height="136" Fill="{StaticResource SpotlightBrush}" />
                    <Button x:Name="LaunchButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnLaunchClick"
                            Style="{StaticResource LaunchButtonStyle}" />
                </Grid>

                <Border Margin="0,24,0,0" Style="{StaticResource GlassTileStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="6,0,18,0">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="CLIENT" />
                            <TextBlock x:Name="ClientTileValueText"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource MetricValueTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                <Ellipse x:Name="ClientTileDot"
                                         Fill="{StaticResource PrimaryBrush}"
                                         Style="{StaticResource StatusDotStyle}" />
                                <TextBlock x:Name="ClientTileStateText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource HairlineBrush}" />

                        <StackPanel Grid.Column="2" Margin="18,0">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="MINECRAFT" />
                            <TextBlock x:Name="MinecraftTileValueText"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource MetricValueTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                <Ellipse x:Name="MinecraftTileDot" Style="{StaticResource StatusDotStyle}" />
                                <TextBlock x:Name="MinecraftTileStateText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Background="{StaticResource HairlineBrush}" />

                        <StackPanel Grid.Column="4" Margin="18,0,6,0">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="ACCOUNT" />
                            <TextBlock x:Name="AccountTileValueText"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource MetricValueTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                <Ellipse x:Name="AccountTileDot" Style="{StaticResource StatusDotStyle}" />
                                <TextBlock x:Name="AccountTileStateText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="CURRENT VERSION" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderBrush="{StaticResource PrimaryDimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Image Width="15" Height="15" Source="{StaticResource OrphanMarkImage}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClientValueText"
                                               Style="{StaticResource CardTitleTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MinecraftValueText"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource SecondaryInfoTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,15,0,0" Style="{StaticResource HairlineBorderStyle}" />
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MetricLabelTextStyle}"
                                           Text="INSTALLATION" />
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Ellipse x:Name="InstallationStatusDot" Style="{StaticResource StatusDotStyle}" />
                                    <TextBlock x:Name="InstallationValueText"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="LATEST UPDATE" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Text="OrphanClient V1" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="The first public client build." />
                            <Button x:Name="ViewDetailsButton"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnViewDetailsClick"
                                    Content="VIEW DETAILS"
                                    Style="{StaticResource LinkButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
