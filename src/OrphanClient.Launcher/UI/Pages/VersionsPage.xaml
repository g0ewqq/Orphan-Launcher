<UserControl x:Class="OrphanClient.Launcher.UI.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,22,40,22">
            <StackPanel MaxWidth="1000">
                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CLIENT VERSIONS" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource PageTitleTextStyle}" Text="Versions" />
                <TextBlock Margin="0,10,0,0"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Every client version this launcher build can run. The current version is used when you press play." />

                <ItemsControl x:Name="VersionList" Margin="0,24,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Style="{StaticResource GlassPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            BorderBrush="{StaticResource PrimaryDimBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Image Width="15" Height="15" Source="{StaticResource OrphanMarkImage}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                                   Text="{Binding ClientLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource SecondaryInfoTextStyle}"
                                                   Text="{Binding MinecraftLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PrimaryChipBorderStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource ChipTextStyle}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="CURRENT" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="VersionSummaryText"
                           Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
