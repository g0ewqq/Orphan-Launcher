<UserControl x:Class="OrphanClient.Launcher.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,22,40,22">
            <StackPanel MaxWidth="1000">
                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PREFERENCES" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                <TextBlock Margin="0,10,0,0"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Launcher preferences are stored in your roaming application data." />

                <Border Margin="0,24,0,0" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="LAUNCHER" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource PrimaryInfoTextStyle}" Text="Start with Windows" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryInfoTextStyle}"
                                           Text="Adds the launcher to the current user's startup entries."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="StartWithWindowsStatusText"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource WarningBrush}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton x:Name="StartWithWindowsToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Start with Windows"
                                          Style="{StaticResource ToggleSwitchStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="MINECRAFT" />
                        <TextBlock Margin="0,13,0,0"
                                   Style="{StaticResource SecondaryInfoTextStyle}"
                                   Text="Folder that contains the versions directory for Minecraft 1.8.9."
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MinecraftDirectoryBox"
                                     Grid.Column="0"
                                     AutomationProperties.Name="Minecraft directory"
                                     KeyDown="OnMinecraftDirectoryKeyDown"
                                     LostFocus="OnMinecraftDirectoryLostFocus"
                                     Style="{StaticResource FieldTextBoxStyle}" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Click="OnBrowseClick"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock x:Name="MinecraftStatusText"
                                   Margin="0,13,0,0"
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="APPEARANCE" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource PrimaryInfoTextStyle}" Text="Enable animations" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryInfoTextStyle}"
                                           Text="Fades and slides content when switching between sections."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton x:Name="AnimationsToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Enable animations"
                                          Style="{StaticResource ToggleSwitchStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="UPDATES" />
                        <TextBlock Margin="0,13,0,0"
                                   Style="{StaticResource SecondaryInfoTextStyle}"
                                   Text="Automatic updates are not available in this build."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="STORAGE" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MetricLabelTextStyle}"
                                       Text="SETTINGS" />
                            <TextBlock x:Name="SettingsPathText"
                                       Grid.Column="1"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonoTextStyle}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MetricLabelTextStyle}"
                                       Text="LOG" />
                            <TextBlock x:Name="LogPathText"
                                       Grid.Column="1"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonoTextStyle}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <TextBlock Margin="0,15,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Launcher activity is appended to the log file."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
